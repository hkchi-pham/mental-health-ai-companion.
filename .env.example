# Database
DATABASE_URL=postgresql://hkchi-p:abc123@db:5432/hkchi-p

# CORS — comma-separated list of allowed browser origins.
# Leave blank to use the localhost dev defaults in app/main.py.
# Native mobile clients don't send an Origin header, so this only affects web.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# JWT Secret
JWT_SECRET_KEY=your-super-secret-key-here
JWT_ALGORITHM=HS256

# AI Provider Configuration
# Options: openai, gemini, huggingface, anthropic
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-2024-08-06

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# HuggingFace Configuration (disabled by default)
HUGGINGFACE_ENABLED=false
HUGGINGFACE_MODEL=bkai-foundation-models/vietnamese-bi-encoder

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
